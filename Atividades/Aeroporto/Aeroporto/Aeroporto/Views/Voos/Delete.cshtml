@model SistemaAereo.Models.Voo

@{
    ViewData["Title"] = "Excluir Voo";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="fas fa-trash"></i> Excluir Voo</h1>
</div>

<div class="alert alert-warning">
    <h5><i class="fas fa-exclamation-triangle"></i> Atenção!</h5>
    <p class="mb-0">Tem certeza que deseja excluir este voo? Esta ação não pode ser desfeita.</p>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Voo @Model.NumeroVoo</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Número:</strong> @Model.NumeroVoo</p>
                        <p><strong>Aeronave:</strong> @Model.Aeronave?.TipoAeronave</p>
                        <p><strong>Saída:</strong> @Model.HorarioSaida.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Origem:</strong> @Model.AeroportoOrigem?.Nome</p>
                        <p><strong>Destino:</strong> @Model.AeroportoDestino?.Nome</p>
                        <p>
                            <strong>Status:</strong>
                            @if (Model.HorarioSaida > DateTime.Now)
                            {
                                <span class="badge bg-success">Agendado</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Concluído</span>
                            }
                        </p>
                    </div>
                </div>

                @if (Model.Escalas?.Any() == true)
                {
                    <div class="mt-3">
                        <p class="text-danger">
                            <i class="fas fa-exclamation-circle"></i>
                            Este voo possui @Model.Escalas.Count escala(s) que também serão excluídas.
                        </p>
                    </div>
                }

                @if (Model.Poltronas?.Any(p => !p.Disponivel) == true)
                {
                    <div class="mt-3">
                        <p class="text-danger">
                            <i class="fas fa-exclamation-circle"></i>
                            Este voo possui poltronas ocupadas. A exclusão removerá todas as reservas.
                        </p>
                    </div>
                }
            </div>
            <div class="card-footer">
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.VooId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Confirmar Exclusão
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>