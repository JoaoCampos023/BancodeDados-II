@model SistemaAereo.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 mb-2 text-dark">Dashboard Geral</h1>
        <p class="text-muted mb-0">Visão completa do sistema de gestão aérea</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-primary btn-modern" onclick="location.reload()">
            <i class="fas fa-sync-alt me-2"></i>Atualizar
        </button>
        <button class="btn btn-primary-modern" onclick="gerarRelatorio()">
            <i class="fas fa-download me-2"></i>Exportar Relatório
        </button>
    </div>
</div>

<!-- Stats Cards Melhoradas -->
<div class="row g-4 mb-5">
    <div class="col-xl-3 col-md-6">
        <div class="stat-card fade-in" style="border-left-color: #3b82f6; animation-delay: 0.1s;">
            <div class="icon text-primary">
                <i class="fas fa-plane-departure"></i>
            </div>
            <div class="number">@Model.TotalVoos</div>
            <div class="label">Voos Ativos</div>
            <div class="mt-2">
                <small class="text-success">
                    <i class="fas fa-arrow-up me-1"></i>12% este mês
                </small>
            </div>
            <div class="position-absolute top-0 end-0 m-3">
                <i class="fas fa-chart-line text-primary opacity-25 fa-lg"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card fade-in" style="border-left-color: #ef4444; animation-delay: 0.2s;">
            <div class="icon text-danger">
                <i class="fas fa-users"></i>
            </div>
            <div class="number">@Model.TotalClientes</div>
            <div class="label">Clientes Ativos</div>
            <div class="mt-2">
                <small class="text-success">
                    <i class="fas fa-arrow-up me-1"></i>8% este mês
                </small>
            </div>
            <div class="position-absolute top-0 end-0 m-3">
                <i class="fas fa-user-friends text-danger opacity-25 fa-lg"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card fade-in" style="border-left-color: #10b981; animation-delay: 0.3s;">
            <div class="icon text-success">
                <i class="fas fa-plane"></i>
            </div>
            <div class="number">@Model.TotalAeronaves</div>
            <div class="label">Aeronaves</div>
            <div class="mt-2">
                <small class="text-success">
                    <i class="fas fa-arrow-up me-1"></i>5% este mês
                </small>
            </div>
            <div class="position-absolute top-0 end-0 m-3">
                <i class="fas fa-fighter-jet text-success opacity-25 fa-lg"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="stat-card fade-in" style="border-left-color: #f59e0b; animation-delay: 0.4s;">
            <div class="icon text-warning">
                <i class="fas fa-building"></i>
            </div>
            <div class="number">@Model.TotalAeroportos</div>
            <div class="label">Aeroportos</div>
            <div class="mt-2">
                <small class="text-success">
                    <i class="fas fa-arrow-up me-1"></i>3% este mês
                </small>
            </div>
            <div class="position-absolute top-0 end-0 m-3">
                <i class="fas fa-map-marker-alt text-warning opacity-25 fa-lg"></i>
            </div>
        </div>
    </div>
</div>

<!-- Resto do seu código permanece igual -->
<div class="row g-4">
    <!-- Próximos Voos -->
    <div class="col-lg-8">
        <!-- ... seu código atual ... -->
    </div>

    <!-- Ações Rápidas -->
    <div class="col-lg-4">
        <!-- ... seu código atual ... -->
    </div>
</div>

<script>
    function gerarRelatorio() {
        // Simulação de geração de relatório
        const toast = document.createElement('div');
        toast.className = 'position-fixed top-0 end-0 m-4 p-3 bg-success text-white rounded shadow';
        toast.style.zIndex = '9999';
        toast.innerHTML = `
            <div class="d-flex align-items-center">
                <i class="fas fa-check-circle me-2"></i>
                <span>Relatório gerado com sucesso!</span>
            </div>
        `;
        document.body.appendChild(toast);

        setTimeout(() => {
            toast.remove();
        }, 3000);
    }

    // Animações ao carregar a página
    document.addEventListener('DOMContentLoaded', function() {
        const cards = document.querySelectorAll('.stat-card');
        cards.forEach((card, index) => {
            card.style.animationDelay = `${index * 0.1}s`;
        });
    });
</script>